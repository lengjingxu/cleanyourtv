<?xml version="1.0" encoding="utf-8"?>
<!--
  Focused row of the Zen list. The wash starts at the left edge and fades to nothing by the right
  edge, so the row reads as light falling across the wallpaper rather than a slab of colour.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#3DFFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
