<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One row is tall enough for the focused type, so the list never moves when focus changes.
         62dp at 240dpi keeps six rows to roughly half of a 1080p screen: the wallpaper stays the
         picture, the list stays a caption under it. -->
    <dimen name="list_row_height">62dp</dimen>
    <dimen name="list_name_size">30sp</dimen>
    <dimen name="list_index_size">11sp</dimen>
    <dimen name="list_gutter">30dp</dimen>
</resources>
